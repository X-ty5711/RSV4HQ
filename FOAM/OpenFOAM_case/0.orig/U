FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

#include "../constant/Ubar.H"
//internalField          uniform (0 0 0);
internalField          uniform $Ubar;

boundaryField
{
    "(bottom|sides)"
    {
        type            noSlip;
    }
    top
    {
        type            symmetryPlane;
    }
    "(inlet|outlet)"
    {
        type            cyclic;
    }
}


