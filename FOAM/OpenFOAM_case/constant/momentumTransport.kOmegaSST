FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      momentumTransport;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Turbulence closure: k-omega SST (Menter), steady RANS (paper, Sec. 2.1).
// Backup copy restored by ./Allmesh to return to the default model.

simulationType  RAS;

RAS
{
    model           kOmegaSST;

    turbulence      on;

    printCoeffs     on;
}


// ************************************************************************* //
